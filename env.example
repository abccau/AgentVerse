# ==============================================================================
# AgentVerse System Environment Variables Configuration
# Copy this file to '.env' and fill in your specific local/cloud values.
# ==============================================================================

# --- System & API Gateway Settings ---
ENV=development
PORT=8000
HOST=0.0.0.0
SECRET_KEY=super-secret-agentverse-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM Provider Configurations ---
# Options: ollama, openai, vllm, openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
OLLAMA_BASE_URL=http://localhost:11434

# --- Vector Database & RAG Configuration ---
# Vector DB type: chroma / faiss / pgvector
VECTOR_DB_TYPE=chroma
CHROMA_DB_DIR=./database/vector_store/chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Relational Database Configuration ---
POSTGRES_USER=agentverse_user
POSTGRES_PASSWORD=agentverse_password
POSTGRES_DB=agentverse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agentverse_user:agentverse_password@localhost:5432/agentverse_db

# --- Memory Subsystem Settings ---
SHORT_TERM_MEMORY_MAX_MESSAGES=20
LONG_TERM_MEMORY_SIMILARITY_THRESHOLD=0.75

# --- External Tools & Sandbox Configuration ---
SERPER_API_KEY=your-serper-web-search-api-key
TAVILY_API_KEY=your-tavily-search-api-key
PYTHON_SANDBOX_TIMEOUT_SECONDS=10

# --- Frontend Client Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
